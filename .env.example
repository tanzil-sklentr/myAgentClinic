# Copy to `.env` and adjust for your local database.
#
# AgentClinic uses MySQL (the walking skeleton was developed against a local
# DBngin MySQL 8 instance). The default DBngin user is `root` with no password.
#
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Example (DBngin default, no password):
DATABASE_URL="mysql://root@127.0.0.1:3306/agentclinic"
